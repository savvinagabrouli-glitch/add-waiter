<Window x:Class="Cursework.Wpf.Views.Dialogs.WaiterOrderDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
        xmlns:vm="clr-namespace:Cursework.Wpf.ViewModels.Admin"
        Title="Детали заказа"
        Width="900"
        Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource Brush.Background}">
    <Window.Resources>
        <conv:OrderItemStatusToRussianConverter x:Key="OrderItemStatusToRussianConverter"/>
        <conv:OrderStatusToRussianConverter x:Key="OrderStatusToRussianConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Border Style="{StaticResource Card}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,16">
                    <TextBlock Text="Детали заказа" Style="{StaticResource H1}"/>
                    <TextBlock>
                        <Run Text="Заказ #" FontSize="14"/>
                        <Run Text="{Binding OrderId}" FontSize="14"/>
                        <Run Text=" · Стол: " FontSize="14"/>
                        <Run Text="{Binding TableName}" FontSize="14"/>
                        <Run Text=" · Статус: " FontSize="14"/>
                        <Run Text="{Binding OrderStatus, Converter={StaticResource OrderStatusToRussianConverter}}" FontSize="14"/>
                    </TextBlock>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Guests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OrderGuestViewModel}">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource H3}" Margin="0,0,0,8"/>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:OrderItemViewModel}">
                                                    <Border Margin="0,0,0,8" Padding="8" Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.L}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="3*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <ComboBox Grid.Row="0"
                                                                      Grid.Column="0"
                                                                      ItemsSource="{Binding DataContext.Dishes, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      SelectedItem="{Binding SelectedDish, Mode=TwoWay}"
                                                                      DisplayMemberPath="Name"
                                                                      Style="{StaticResource ComboBox.Base}"
                                                                      MinWidth="220"/>

                                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="8,0,0,0">
                                                                <TextBlock Text="Кол-во" Style="{StaticResource Caption}"/>
                                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource TextBox.Base}"
                                                                         Width="60"
                                                                         HorizontalContentAlignment="Right"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Vertical" Margin="8,0,0,0">
                                                                <TextBlock Text="Сумма" Style="{StaticResource Caption}"/>
                                                                <TextBox Text="{Binding Price, StringFormat={}{0:0.00}}"
                                                                         Style="{StaticResource TextBox.Base}"
                                                                         IsReadOnly="True"
                                                                         MinWidth="80"
                                                                         HorizontalContentAlignment="Right"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Vertical" Margin="8,0,0,0">
                                                                <TextBlock Text="Статус" Style="{StaticResource Caption}"/>
                                                                <TextBlock Text="{Binding Status, Converter={StaticResource OrderItemStatusToRussianConverter}}"/>
                                                            </StackPanel>

                                                            <Button Grid.Row="0" Grid.Column="4" Content="✕" Margin="8,0,0,0" Width="32" Height="32" Style="{StaticResource Button.Outline}" Foreground="{StaticResource Brush.Danger}" BorderBrush="{StaticResource Brush.Danger}" ToolTip="Удалить блюдо" Command="{Binding DataContext.RemoveDishCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>

                                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Vertical" Margin="0,8,0,0">
                                                                <TextBlock Text="Заметки" Style="{StaticResource Caption}"/>
                                                                <TextBox Text="{Binding Notes}" Style="{StaticResource TextBox.Base}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Content="Добавить блюдо" Style="{StaticResource Button.Outline}" Command="{Binding DataContext.AddDishCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <StackPanel Orientation="Vertical" Margin="0,0,16,0" HorizontalAlignment="Left">
                        <TextBlock Text="Итого" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:0.00}}" Style="{StaticResource H2}"/>
                    </StackPanel>
                    <Button Content="Сохранить" Style="{StaticResource Button.Base}" Command="{Binding SaveCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Content="Отмена" Style="{StaticResource Button.Outline}" Command="{Binding CancelCommand}" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
