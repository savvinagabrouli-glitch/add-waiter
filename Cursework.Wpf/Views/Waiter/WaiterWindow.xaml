<Window x:Class="Cursework.Wpf.Views.Waiter.WaiterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Cursework.Wpf.Converters"
        xmlns:controls="clr-namespace:Cursework.Wpf.Views.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Рабочее место официанта"
        Background="{StaticResource Brush.Background}"
        Width="1400"
        Height="820"
        Icon="pack://application:,,,/Assets/Icon/app.ico">
    <Window.Resources>
        <conv:RoleDisplayConverter x:Key="RoleDisplay"/>
        <conv:CallWaiterTypeToTextConverter x:Key="CallType"/>
        <conv:StatusToRussianConverter x:Key="StatusToRu"/>
        <conv:OrderStatusToRussianConverter x:Key="OrderStatusToRu"/>
        <conv:OrderItemStatusToRussianConverter x:Key="OrderItemStatusToRu"/>
        <conv:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border CornerRadius="16" Padding="20" Background="White" BorderBrush="#1A2B3340" BorderThickness="1" MinHeight="80">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#FF2D7EF7" VerticalAlignment="Center">
                        <TextBlock Text="ТК" Foreground="White" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Управление кафе" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock FontSize="14" Opacity="0.8" Text="{Binding Map.SelectedZoneTitle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentStaff.Name}" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" />
                        <Border CornerRadius="999" Padding="8,2" HorizontalAlignment="Center" Background="#FFF3F4F7">
                            <TextBlock Text="{Binding CurrentStaff.Role, Converter={StaticResource RoleDisplay}}" FontSize="13" Opacity="0.8" />
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource Button.Outline}" Padding="12,8" Command="{Binding ToggleNotificationsCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="🔔" FontSize="16"/>
                            <TextBlock Text="Уведомления"/>
                            <Border Background="{StaticResource Brush.Accent}" CornerRadius="10" Padding="6,2" Visibility="{Binding NotificationsCount, Converter={StaticResource IntToVisibilityConverter}}">
                                <TextBlock Text="{Binding NotificationsCount}" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Map area -->
            <Border Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="24" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="MapScroll"
                                  Grid.Row="0"
                                  PreviewMouseWheel="MapScroll_PreviewMouseWheel"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Background="Transparent">
                        <Grid MinWidth="900" MinHeight="650" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleX="{Binding Map.Zoom}" ScaleY="{Binding Map.Zoom}"/>
                            </Grid.LayoutTransform>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Map.SelectedZone}" Value="MainHall">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/main-hall.png"
                                                             ItemsSource="{Binding Map.TablesOnMap}"
                                                             SelectedItem="{Binding Map.SelectedTableOnMap, Mode=TwoWay}"
                                                             Zoom="{Binding Map.Zoom}"
                                                             IsDragEnabled="False"
                                                             IsContextMenuEnabled="False"/>
                            </Grid>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Map.SelectedZone}" Value="Terrace">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/terrace.png"
                                                             ItemsSource="{Binding Map.TablesOnMap}"
                                                             SelectedItem="{Binding Map.SelectedTableOnMap, Mode=TwoWay}"
                                                             Zoom="{Binding Map.Zoom}"
                                                             IsDragEnabled="False"
                                                             IsContextMenuEnabled="False"/>
                            </Grid>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Map.SelectedZone}" Value="Bar">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/terrace.png"
                                                             ItemsSource="{Binding Map.TablesOnMap}"
                                                             SelectedItem="{Binding Map.SelectedTableOnMap, Mode=TwoWay}"
                                                             Zoom="{Binding Map.Zoom}"
                                                             IsDragEnabled="False"
                                                             IsContextMenuEnabled="False"/>
                            </Grid>

                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Map.SelectedZone}" Value="VIP">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:HallMapZoneControl BackgroundSource="/Assets/Images/Halls/terrace.png"
                                                             ItemsSource="{Binding Map.TablesOnMap}"
                                                             SelectedItem="{Binding Map.SelectedTableOnMap, Mode=TwoWay}"
                                                             Zoom="{Binding Map.Zoom}"
                                                             IsDragEnabled="False"
                                                             IsContextMenuEnabled="False"/>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0" HorizontalAlignment="Center" Orientation="Vertical" Spacing="6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                            <Button Content="←" Width="44" Height="44" Style="{StaticResource Button.Outline}" Command="{Binding PrevZoneCommand}"/>
                            <TextBlock Text="{Binding Map.SelectedZoneTitle}" FontSize="16" FontWeight="SemiBold" MinWidth="200" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <Button Content="→" Width="44" Height="44" Style="{StaticResource Button.Outline}" Command="{Binding NextZoneCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Масштаб" VerticalAlignment="Center"/>
                            <Slider x:Name="ZoomSlider" Minimum="0.2" Maximum="4.0" Width="240" Value="{Binding Map.Zoom}" ValueChanged="ZoomSlider_ValueChanged"/>
                            <TextBlock Text="{Binding Map.Zoom, StringFormat={}{0:F2}x}" Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right panel -->
            <StackPanel Grid.Column="1" Spacing="12">
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Стол" Style="{StaticResource H3}"/>
                        <TextBlock Text="{Binding SelectedTableName}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedTableSeats, StringFormat=Мест: {0}}" Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding SelectedTableStatus, Converter={StaticResource StatusToRu}}" Foreground="{StaticResource Brush.TextMuted}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Заказ" Style="{StaticResource H3}"/>
                        <TextBlock Text="{Binding ActiveOrder.Id, StringFormat=№ {0}}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ActiveOrderStatus, Converter={StaticResource OrderStatusToRu}}" Foreground="{StaticResource Brush.TextMuted}"/>
                        <TextBlock Text="{Binding ActiveOrderTotal, StringFormat=Сумма: {0:0.00}}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Создать заказ" Style="{StaticResource Button.Base}" Command="{Binding CreateOrderCommand}"/>
                            <Button Content="Детали" Style="{StaticResource Button.Outline}" Command="{Binding ViewOrderCommand}" IsEnabled="{Binding IsOrderActive}"/>
                        </StackPanel>
                        <Button Content="Закрыть заказ" Style="{StaticResource Button.Outline}" Command="{Binding CloseOrderCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Позиции заказа" Style="{StaticResource H3}"/>
                        <ItemsControl ItemsSource="{Binding OrderItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.M}" Padding="8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DishName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Quantity, StringFormat=Количество: {0}}" Foreground="{StaticResource Brush.TextMuted}"/>
                                                <TextBlock Text="{Binding Price, StringFormat=Сумма: {0:0.00}}" Foreground="{StaticResource Brush.TextMuted}"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" Width="140" SelectedValue="{Binding Status, Mode=TwoWay}">
                                                <ComboBox.ItemsSource>
                                                    <x:Array Type="{x:Type sys:String}" xmlns:sys="clr-namespace:System;assembly=mscorlib">
                                                        <sys:String>Ordered</sys:String>
                                                        <sys:String>Preparing</sys:String>
                                                        <sys:String>Served</sys:String>
                                                    </x:Array>
                                                </ComboBox.ItemsSource>
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Converter={StaticResource OrderItemStatusToRu}}"/>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="💾" Style="{StaticResource Button.Outline}" Command="{Binding DataContext.SaveItemsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="8,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Notifications panel -->
            <Border Grid.Column="2" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="12" Width="360" Visibility="{Binding IsNotificationsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Вызовы официанта" Style="{StaticResource H2}"/>
                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Table.Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{StaticResource Brush.TextMuted}"/>
                                        <TextBlock Text="{Binding Type, Converter={StaticResource CallType}}" Foreground="{StaticResource Brush.TextMuted}"/>
                                        <Button Content="Принять" Style="{StaticResource Button.Base}" Command="{Binding DataContext.AcceptNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
